# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sipariş kayıtları (kişisel veri — repoya girmesin)
/data/

# ürün fotoğraflarının orijinalleri (siteye giden küçültülmüş hâlleri public/urunler/ içinde)
/fotograflar/*
!/fotograflar/BENI-OKU.md

# Dolap yorumlarının ekran görüntüleri (sadece yorumları aktarmak için)
/dolap-yorumlari/*
!/dolap-yorumlari/BENI-OKU.md
